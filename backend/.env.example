# MrBiz-OS core-go — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
# Rotate any secret that was ever committed before using it again.

# ── Database ──────────────────────────────────────────────────────────────
# Keep USE_SQLITE=false in production — true connects to an empty SQLite file
# and makes ALL logins fail (users exist only in PostgreSQL).
USE_SQLITE=false
REQUIRE_MFA=true
DB_URL="host=<host> user=<db_user> password=<db_password> dbname=<db_name> port=5432 sslmode=require TimeZone=Asia/Kolkata"

# Fallback vars (used only if DB_URL is empty)
POSTGRES_SERVER=localhost
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=<db_name>
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL="redis://:<redis_password>@localhost:6379/0"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>

# ── App ─────────────────────────────────────────────────────────────────
APP_ENV=development            # set to "production" in prod (gates PHI key + schedulers)
GO_PORT=8081
CORS_ALLOWED_ORIGINS=https://medihub.mrbiz.in,http://localhost:3000
# Generate a strong random value (e.g. openssl rand -base64 48). Required — app panics if unset.
JWT_SECRET=<strong_random_jwt_secret>

# ── LiveKit (video) ───────────────────────────────────────────────────────
LIVEKIT_API_KEY=<livekit_api_key>
LIVEKIT_API_SECRET=<livekit_api_secret>
LIVEKIT_HTTP_URL=https://rtc.mrbiz.in
LIVEKIT_WS_URL=wss://rtc.mrbiz.in

# ── LLM fallback (optional; rule-based engine works without it) ─────────────
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Razorpay payment gateway ───────────────────────────────────────────────
RAZORPAY_KEY_ID=<razorpay_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
# Razorpay Payouts (optional; falls back to the keys above if blank)
RAZORPAY_PAYOUT_KEY_ID=
RAZORPAY_PAYOUT_KEY_SECRET=
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=

# ── Firebase Cloud Messaging (optional) ─────────────────────────────────────
# Option A: entire service-account JSON as a single escaped line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: path to service-account JSON inside the container
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Meta WhatsApp Cloud API (optional) ──────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en_IN

# ── SMTP (optional email delivery) ──────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@medihub.mrbiz.in
# SMTP_PASS=<smtp_password>

# ── Resend transactional email (optional) ───────────────────────────────────
RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL=noreply@mrbiz.in
RESEND_FROM_NAME=Dr.Ayya

# ── Cryptography (REQUIRED in production) ───────────────────────────────────
# AES-256-GCM key for medical PHI. App refuses to boot in prod if unset.
# Generate: openssl rand -base64 32
DB_ENCRYPTION_KEY=<base64_32byte_key>

# ── Finance security (REQUIRED in production) ───────────────────────────────
# Salt for ledger integrity hashes. Generate: openssl rand -base64 24
FINANCE_SECRET_SALT=<base64_salt>
